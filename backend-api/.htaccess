# ==============================================================
# RADAR STOCK - Seguridad Apache / LiteSpeed (Hostinger)
# ==============================================================

# 1. Bloquear acceso web directo a carpetas sensibles (config e includes)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|includes)(/.*)?$ - [F,L]
</IfModule>

# 2. Bloquear acceso web a archivos de logs, scripts SQL y documentación markdown
<FilesMatch "\.(log|sql|md)$">
    Require all denied
</FilesMatch>

# 3. Bloquear archivos ocultos (.htaccess, .env, .git, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
