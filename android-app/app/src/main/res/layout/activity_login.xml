<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_margin_horizontal"
        android:paddingVertical="@dimen/screen_padding_large">

        <!-- Tarjeta Principal del Formulario de Login -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLogin"
            style="@style/RadarStock_Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardElevation="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="480dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding_large">

                <!-- Logo de la App -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivLogoApp"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:contentDescription="Logo Radar Stock"
                    android:src="@drawable/ic_logo_radar_stock"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                <!-- Encabezado de la App -->
                <TextView
                    android:id="@+id/tvTituloApp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="Radar Stock"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_title_hero"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtituloApp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Inventario y Ventas para tu Almacén"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <!-- Filete sutil decorativo -->
                <View
                    android:layout_width="60dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:background="@color/accent_gold" />

                <!-- Campo Correo Electrónico -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCorreo"
                    style="@style/RadarStock_TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xlarge"
                    android:hint="Correo electrónico"
                    app:startIconDrawable="@android:drawable/ic_dialog_email"
                    app:startIconTint="@color/text_placeholder">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCorreo"
                        style="@style/RadarStock_TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Contraseña -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/RadarStock_TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:hint="Contraseña"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/text_placeholder"
                    app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                    app:startIconTint="@color/text_placeholder">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        style="@style/RadarStock_TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Mensaje de Error -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:background="@color/status_danger_bg"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textColor="@color/status_danger"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Correo o contraseña incorrectos"
                    tools:visibility="visible" />

                <!-- Indicador de Carga -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:indeterminateTint="@color/accent_action"
                    android:visibility="gone"
                    tools:visibility="gone" />

                <!-- Botón Ingresar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIngresar"
                    style="@style/RadarStock_Button_Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:text="Ingresar" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
