<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardMovimiento"
    style="@style/RadarStock_Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
    android:layout_marginVertical="6dp"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila 1: Fecha y Hora + Etiqueta de Tipo (Ingreso / Conteo / Ajuste) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_placeholder"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="09-11-2026 10:45" />

            <TextView
                android:id="@+id/tvTipoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_alerta_tag"
                android:backgroundTint="@color/status_success"
                android:letterSpacing="0.04"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="INGRESO" />
        </LinearLayout>

        <!-- Fila 2: Nombre del Producto -->
        <TextView
            android:id="@+id/tvNombreProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Fideos Spaghetti Nº5 Lucchetti 400g" />

        <!-- Fila 3: Código de barras (si existe) -->
        <TextView
            android:id="@+id/tvCodigoBarras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_placeholder"
            android:textSize="13sp"
            tools:text="Código: 7801234567890" />

        <!-- Fila 4: Usuario que realizó el movimiento -->
        <TextView
            android:id="@+id/tvUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Realizado por: Guillermo Rios" />

        <!-- Fila 5: Caja con Transición de Stock y Diferencia Destacada -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ranking_badge"
            android:backgroundTint="#F8FAFC"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvTransicionStock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Stock: 10 → 15" />

            <TextView
                android:id="@+id/tvDiferenciaBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_alerta_tag"
                android:backgroundTint="#DCFCE7"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#15803D"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="+5" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

