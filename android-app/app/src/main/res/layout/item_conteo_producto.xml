<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardItemConteo"
    style="@style/RadarStock_Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <!-- Fila Superior: Nombre del Producto y Botón Quitar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNombreProducto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Arroz Grado 1 Extra 1kg" />

            <ImageButton
                android:id="@+id/btnEliminarItem"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quitar del conteo"
                android:padding="6dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/text_placeholder" />
        </LinearLayout>

        <!-- Subtítulo: Stock Sistema y Código -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStockSistema"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Stock en sistema: 20 uds" />

            <TextView
                android:id="@+id/tvCodigoBarras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_placeholder"
                android:textSize="12sp"
                tools:text="Cod: 780123456789" />
        </LinearLayout>

        <!-- Divisor sutil -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/divider" />

        <!-- Fila de Entrada: Campo Contado y Diferencia calculada en vivo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Campo «Contado» -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilContado"
                style="@style/RadarStock_TextInputLayout"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:hint="Contado *">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContado"
                    style="@style/RadarStock_TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textStyle="bold"
                    tools:text="20" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Indicador de Diferencia -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDiferenciaBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_role_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:backgroundTint="#DCFCE7"
                    tools:text="Diferencia: 0"
                    tools:textColor="#15803D" />

                <TextView
                    android:id="@+id/tvEstadoDiferencia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp"
                    tools:text="Stock exacto"
                    tools:textColor="#15803D" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
