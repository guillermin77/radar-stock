<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Barra Superior / Encabezado Azul Marino -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/RadarStock_Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="Inventario de Productos"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Barra de Búsqueda -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBuscar"
            style="@style/RadarStock_TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
            android:layout_marginTop="@dimen/spacing_small"
            android:hint="Buscar por nombre o código de barras..."
            app:endIconMode="clear_text"
            app:endIconTint="@color/text_placeholder"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="@color/text_placeholder"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBuscar"
                style="@style/RadarStock_TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fila Horizontal de Categorías (con opción 'Todas') -->
        <HorizontalScrollView
            android:id="@+id/scrollCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_margin_horizontal"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/tilBuscar">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategorias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!-- RecyclerView de Productos con Padding Inferior para evitar superposición del FAB -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProductos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_small"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/list_bottom_padding"
            app:layout_constraintBottom_toTopOf="@id/pbPaginacion"
            app:layout_constraintTop_toBottomOf="@id/scrollCategorias"
            tools:listitem="@layout/item_producto" />

        <!-- Indicador de Carga de Paginación -->
        <ProgressBar
            android:id="@+id/pbPaginacion"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="8dp"
            android:indeterminateTint="@color/primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="gone" />

        <!-- Indicador de Carga Inicial -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollCategorias"
            tools:visibility="visible" />

        <!-- Mensaje: Lista Vacía -->
        <LinearLayout
            android:id="@+id/layoutVacio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollCategorias">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:alpha="0.35"
                android:contentDescription="Sin resultados"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/text_placeholder" />

            <TextView
                android:id="@+id/tvMensajeVacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="No se encontraron productos"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Intenta con otro término o selecciona otra categoría."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Mensaje: Error de Conexión -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollCategorias">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No se pudo conectar con el servidor"
                android:textColor="@color/status_danger"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvErrorDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Verifica tu conexión y que el servidor XAMPP esté activo."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentar"
                style="@style/RadarStock_Button_Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="16dp"
                android:text="Reintentar conexión" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Botones Flotantes de Acción (Visibles solo para Administrador) -->
    <LinearLayout
        android:id="@+id/layoutAccionesAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- Botón «Escanear» (Verde #15803D con icono y texto blancos) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEscanear"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/status_success"
            android:contentDescription="Escanear producto"
            android:elevation="4dp"
            android:paddingHorizontal="20dp"
            android:text="Escanear"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="24dp"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconTint="@color/white"
            tools:visibility="visible" />

        <!-- Botón Flotante «+» (Azul #2563EB con icono blanco) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAgregarProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/accent_action"
            android:contentDescription="Crear Producto"
            android:src="@android:drawable/ic_input_add"
            android:visibility="gone"
            app:elevation="4dp"
            app:tint="@color/white"
            tools:visibility="visible" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
