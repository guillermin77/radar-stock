<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar Corporativo -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/RadarStock_Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/white"
            app:subtitle="Rendimiento por usuario"
            app:subtitleTextColor="#CCFFFFFF"
            app:title="Comparar vendedores"
            app:titleTextColor="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin_horizontal"
            android:paddingTop="10dp">

            <!-- Chips de Período -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPeriodo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipHoy"
                        style="@style/RadarStock_Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Hoy" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip7Dias"
                        style="@style/RadarStock_Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 días" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMes"
                        style="@style/RadarStock_Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Este mes" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRango"
                        style="@style/RadarStock_Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rango" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Selector de Rango Personalizado -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutSelectorRango"
                style="@style/RadarStock_Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFechaDesde"
                        style="@style/RadarStock_Button_Secondary"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:minHeight="44dp"
                        android:paddingHorizontal="6dp"
                        android:textSize="11.5sp"
                        tools:text="Desde: 2026-11-01" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:text="a"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFechaHasta"
                        style="@style/RadarStock_Button_Secondary"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:minHeight="44dp"
                        android:paddingHorizontal="6dp"
                        android:textSize="11.5sp"
                        tools:text="Hasta: 2026-11-10" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAplicarRango"
                        style="@style/RadarStock_Button_Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:minHeight="44dp"
                        android:paddingHorizontal="12dp"
                        android:text="Ver"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón Exportar CSV -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportarCsv"
                style="@style/RadarStock_Button_Secondary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:minHeight="44dp"
                android:text="Exportar CSV"
                app:icon="@android:drawable/ic_menu_share"
                app:iconTint="@color/accent_action" />

            <!-- Tarjeta Total General -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTotalGeneral"
                style="@style/RadarStock_Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total general del período"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCantidadTotalVentas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            tools:text="32 ventas totales" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTotalGeneralMonto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/navy_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="$425.000" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contenedor Central para Lista / Carga / Error / Vacío -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvVendedores"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp"
                    tools:listitem="@layout/item_comparar_vendedor" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/navy_primary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="No hay ventas registradas en el período"
                    android:textColor="@color/text_placeholder"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvMensajeError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/status_danger"
                        android:textSize="14sp"
                        tools:text="Error de conexión" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReintentar"
                        style="@style/RadarStock_Button_Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:minHeight="44dp"
                        android:text="Reintentar" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

