<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Barra Superior / Encabezado Corporativo -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/RadarStock_Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/white"
            app:title="Detalle del Producto"
            app:titleTextColor="@color/white"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Tarjeta de Datos del Producto -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDetalle"
            style="@style/RadarStock_Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/screen_margin_horizontal"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Nombre -->
                <TextView
                    android:id="@+id/tvNombreProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Bebida Coca-Cola Original 1.5L" />

                <!-- Categoría -->
                <TextView
                    android:id="@+id/tvCategoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_role_chip"
                    android:backgroundTint="#EFF6FF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/navy_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Bebidas" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/divider" />

                <!-- Código de Barras -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Código de barras"
                    android:textColor="@color/text_placeholder"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvCodigoBarras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    tools:text="7801610000011" />

                <!-- Precio -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Precio de venta"
                    android:textColor="@color/text_placeholder"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPrecio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/navy_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="$1.800" />

                <!-- Stock Actual -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Stock actual"
                    android:textColor="@color/text_placeholder"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvStockActual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="15 unidades" />

                <!-- Parámetros de Stock (Mínimo y Deseado) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stock mínimo"
                            android:textColor="@color/text_placeholder"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvStockMinimo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            tools:text="6 unidades" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stock deseado"
                            android:textColor="@color/text_placeholder"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvStockDeseado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            tools:text="24 unidades" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Fecha de Vencimiento -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Fecha de vencimiento"
                    android:textColor="@color/text_placeholder"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvFechaVencimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    tools:text="2026-11-20" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Acciones exclusivas del Administrador (Editar y Agregar Stock) -->
        <LinearLayout
            android:id="@+id/layoutAccionesAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardDetalle"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgregarStock"
                style="@style/RadarStock_Button_Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:text="Agregar Stock" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarProducto"
                style="@style/RadarStock_Button_Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="10dp"
                android:text="Editar Producto" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerHistorial"
                style="@style/RadarStock_Button_Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="10dp"
                android:text="Ver Historial de Movimientos"
                app:icon="@android:drawable/ic_menu_recent_history"
                app:iconGravity="textStart" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
