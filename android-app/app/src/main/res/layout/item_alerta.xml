<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAlerta"
    style="@style/RadarStock_Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Barra lateral de color / Ícono de Alerta -->
        <LinearLayout
            android:id="@+id/layoutIconoAlerta"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_alerta_icono"
            android:backgroundTint="#FEE2E2"
            android:gravity="center">

            <ImageView
                android:id="@+id/ivIconoAlerta"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Icono de alerta"
                app:srcCompat="@drawable/ic_alerta_vencido"
                app:tint="@color/status_danger" />
        </LinearLayout>

        <!-- Contenido de la Alerta -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Fila Superior: Etiqueta textual del tipo + Nombre de Producto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/tvEtiquetaTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_alerta_tag"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:letterSpacing="0.04"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="[SIN STOCK]" />

                <TextView
                    android:id="@+id/tvNombreProducto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Leche Entera 1L" />
            </LinearLayout>

            <!-- Mensaje Descriptivo de la Alerta -->
            <TextView
                android:id="@+id/tvMensajeAlerta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Stock bajo: Leche Entera 1L tiene 8 unidades (mínimo 10). Conviene reponer." />

            <!-- Fila de Detalles Técnicos de Stock / Vencimiento -->
            <LinearLayout
                android:id="@+id/layoutDetalles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetalleStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_placeholder"
                    android:textSize="12sp"
                    tools:text="Stock: 8 / Mín: 10 / Des: 30" />

                <TextView
                    android:id="@+id/tvDetalleVencimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/text_placeholder"
                    android:textSize="12sp"
                    tools:text="Vence: 20-11-2026" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
