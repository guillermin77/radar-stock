<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar Corporativo -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/RadarStock_Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/white"
            app:title="Ventas por vendedor"
            app:titleTextColor="@color/white" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContenido"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_margin_horizontal">

                <!-- Encabezado con nombre del vendedor y estado -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/RadarStock_Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNombreVendedorHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="Juan Pérez" />

                            <TextView
                                android:id="@+id/tvRolVendedorHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                tools:text="Rol: Vendedor" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvEstadoVendedorHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:background="#DCFCE7"
                            tools:text="Activo"
                            tools:textColor="#15803D" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chips de Período -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupPeriodo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipHoy"
                            style="@style/RadarStock_Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Hoy" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip7Dias"
                            style="@style/RadarStock_Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7 días" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMes"
                            style="@style/RadarStock_Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Este mes" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipRango"
                            style="@style/RadarStock_Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rango" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Selector de Rango Personalizado -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layoutSelectorRango"
                    style="@style/RadarStock_Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFechaDesde"
                            style="@style/RadarStock_Button_Secondary"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:minHeight="44dp"
                            android:paddingHorizontal="6dp"
                            android:textSize="11.5sp"
                            tools:text="Desde: 2026-11-01" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:text="a"
                            android:textColor="@color/text_secondary"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFechaHasta"
                            style="@style/RadarStock_Button_Secondary"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:minHeight="44dp"
                            android:paddingHorizontal="6dp"
                            android:textSize="11.5sp"
                            tools:text="Hasta: 2026-11-10" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAplicarRango"
                            style="@style/RadarStock_Button_Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:minHeight="44dp"
                            android:paddingHorizontal="12dp"
                            android:text="Ver"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Botón Exportar CSV -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportarCsv"
                    style="@style/RadarStock_Button_Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:minHeight="44dp"
                    android:text="Exportar CSV"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconTint="@color/accent_action" />

                <!-- Estado Carga / Error -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="24dp"
                    android:indeterminateTint="@color/navy_primary"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvMensajeError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/status_danger"
                        android:textSize="14sp"
                        tools:text="No se pudieron cargar las ventas." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReintentar"
                        style="@style/RadarStock_Button_Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:minHeight="44dp"
                        android:text="Reintentar" />
                </LinearLayout>

                <!-- Bloque de Contenido Principal -->
                <LinearLayout
                    android:id="@+id/layoutContenidoDatos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- Tarjetas de Métricas: Total, N.° Ventas, Ticket Promedio -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/RadarStock_Card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total vendido"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11.5sp" />

                                <TextView
                                    android:id="@+id/tvTotalVendido"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/navy_primary"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="$145.000" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            style="@style/RadarStock_Card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="N.° de ventas"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11.5sp" />

                                <TextView
                                    android:id="@+id/tvCantidadVentas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/navy_primary"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="14" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/RadarStock_Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Ticket promedio por venta"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvTicketPromedio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/navy_primary"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="$10.357" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Estado Vacío -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutVacio"
                        style="@style/RadarStock_Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="24dp"
                            android:text="Este vendedor no tiene ventas en el período"
                            android:textColor="@color/text_placeholder"
                            android:textSize="14.5sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Sección: Más vendidos -->
                    <LinearLayout
                        android:id="@+id/layoutSeccionMasVendidos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Más vendidos"
                            android:textColor="@color/navy_primary"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvMasVendidos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_resumen_producto" />
                    </LinearLayout>

                    <!-- Sección: Lista paginada de Ventas -->
                    <LinearLayout
                        android:id="@+id/layoutSeccionVentas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Historial de ventas (toca una venta para ver detalle)"
                            android:textColor="@color/navy_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvVentas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_venta_vendedor" />

                        <ProgressBar
                            android:id="@+id/progressBarMas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginVertical="10dp"
                            android:indeterminateTint="@color/navy_primary"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCargarMas"
                            style="@style/RadarStock_Button_Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="16dp"
                            android:minHeight="44dp"
                            android:text="Cargar más"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

