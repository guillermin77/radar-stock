<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayoutAlertas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Barra Superior / Encabezado Corporativo -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/RadarStock_Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/white"
            app:title="Alertas de Inventario"
            app:titleTextColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Fila de Filtros con Conteos -->
        <HorizontalScrollView
            android:id="@+id/scrollFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_margin_horizontal"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFiltros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTodas"
                    style="@style/RadarStock_Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Todas (0)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAgotados"
                    style="@style/RadarStock_Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agotados (0)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCriticos"
                    style="@style/RadarStock_Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Críticos (0)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBajos"
                    style="@style/RadarStock_Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bajos (0)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPorVencer"
                    style="@style/RadarStock_Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Por vencer (0)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVencidos"
                    style="@style/RadarStock_Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vencidos (0)" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Banner sutil de actualización / aviso -->
        <TextView
            android:id="@+id/tvBannerActualizando"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EFF6FF"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:text="Actualizando alertas..."
            android:textColor="@color/navy_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/scrollFiltros" />

        <!-- RecyclerView de Alertas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlertas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/list_bottom_padding"
            app:layout_constraintBottom_toTopOf="@id/pbPaginacion"
            app:layout_constraintTop_toBottomOf="@id/tvBannerActualizando"
            tools:listitem="@layout/item_alerta" />

        <!-- Indicador de Carga de Paginación -->
        <ProgressBar
            android:id="@+id/pbPaginacion"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="8dp"
            android:indeterminateTint="@color/navy_primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Indicador de Carga Inicial -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/navy_primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollFiltros"
            tools:visibility="visible" />

        <!-- Estado Vacío: Todo en orden -->
        <LinearLayout
            android:id="@+id/layoutVacio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollFiltros">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:alpha="0.8"
                android:contentDescription="Todo en orden"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="@color/status_success" />

            <TextView
                android:id="@+id/tvMensajeVacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Todo en orden: no hay alertas"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtituloVacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="El inventario y las fechas de vencimiento cumplen con los parámetros establecidos."
                android:textColor="@color/text_placeholder"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Estado Error de Conexión -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollFiltros">

            <TextView
                android:id="@+id/tvTituloError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Error al conectar con el servidor"
                android:textColor="@color/status_danger"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMensajeError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="No se pudo obtener la información de alertas. Revisa tu conexión de red o el servidor XAMPP."
                android:textColor="@color/text_placeholder"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentar"
                style="@style/RadarStock_Button_Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Reintentar" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
