<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Toolbar Superior Corporativo -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/RadarStock_Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/white"
            app:title="Gestión de Usuarios"
            app:titleTextColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Subtítulo / Indicador informativo -->
        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EFF6FF"
            android:paddingHorizontal="@dimen/screen_margin_horizontal"
            android:paddingVertical="10dp"
            android:text="Toca cualquier usuario para ver sus ventas, editar, resetear clave o cambiar estado."
            android:textColor="@color/navy_primary"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <!-- Botón Comparar Vendedores (Solo Administrador) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompararVendedores"
            style="@style/RadarStock_Button_Secondary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
            android:layout_marginTop="10dp"
            android:minHeight="44dp"
            android:text="Comparar vendedores"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            app:iconTint="@color/accent_action"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitulo" />

        <!-- Lista de Usuarios -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUsuarios"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="@dimen/list_bottom_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnCompararVendedores"
            tools:listitem="@layout/item_usuario" />

        <!-- Mensaje de Lista Vacía -->
        <TextView
            android:id="@+id/tvEmptyUsuarios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No hay usuarios registrados"
            android:textColor="@color/text_placeholder"
            android:textSize="15sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnCompararVendedores" />

        <!-- Indicador de Carga -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/navy_primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnCompararVendedores" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Botón Flotante para Crear Nuevo Usuario en Azul de Acción -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnNuevoUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:backgroundTint="@color/blue_action"
        android:text="Nuevo usuario"
        android:textColor="@color/white"
        app:elevation="4dp"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
