<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========================================================== -->
    <!-- INPUTS Y FORMULARIOS (OutlinedBox Unificado)               -->
    <!-- ========================================================== -->
    <style name="RadarStock_TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_card</item>
        <item name="boxStrokeColor">@color/sl_input_stroke</item>
        <item name="boxStrokeWidth">@dimen/input_stroke_width</item>
        <item name="boxStrokeWidthFocused">@dimen/input_stroke_focused</item>
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="android:textColorHint">@color/text_placeholder</item>
        <item name="hintTextColor">@color/accent_action</item>
        <item name="errorTextColor">@color/status_danger</item>
        <item name="boxStrokeErrorColor">@color/status_danger</item>
        <item name="errorIconTint">@color/status_danger</item>
        <item name="endIconTint">@color/text_placeholder</item>
        <item name="startIconTint">@color/text_placeholder</item>
    </style>

    <style name="RadarStock_TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_placeholder</item>
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:minHeight">@dimen/input_min_height</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <!-- ========================================================== -->
    <!-- CHIPS DE CATEGORÍA Y FILTROS                               -->
    <!-- ========================================================== -->
    <style name="RadarStock_Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/sl_chip_background</item>
        <item name="android:textColor">@color/sl_chip_text</item>
        <item name="chipStrokeColor">@color/sl_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- ========================================================== -->
    <!-- BOTONES PRINCIPALES, SECUNDARIOS Y ACCIONES                -->
    <!-- ========================================================== -->
    <style name="RadarStock_Button_Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="backgroundTint">@color/accent_action</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/btn_corner_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="RadarStock_Button_Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="android:textColor">@color/accent_action</item>
        <item name="strokeColor">@color/accent_action</item>
        <item name="strokeWidth">@dimen/btn_stroke_width</item>
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/btn_corner_radius</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="RadarStock_Button_Destructive" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="android:textColor">@color/status_danger</item>
        <item name="strokeColor">@color/status_danger</item>
        <item name="strokeWidth">@dimen/btn_stroke_width</item>
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/btn_corner_radius</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="RadarStock_Button_Gold" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="backgroundTint">@color/accent_gold</item>
        <item name="android:textColor">@color/text_on_gold</item>
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/btn_corner_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="RadarStock_Button_Scan" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="backgroundTint">@color/status_success</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/btn_corner_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconTint">@color/white</item>
    </style>

    <!-- Botón en formato tarjeta cuadrícula para Menú -->
    <style name="RadarStock_Button_MenuCard" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:layout_height">@dimen/menu_card_height</item>
        <item name="android:minHeight">@dimen/menu_card_height</item>
        <item name="backgroundTint">@color/surface_card</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/card_corner_radius</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="android:elevation">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">28dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconTint">@color/primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ========================================================== -->
    <!-- TARJETAS Y CONTENEDORES                                    -->
    <!-- ========================================================== -->
    <style name="RadarStock_Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="cardElevation">@dimen/card_elevation</item>
    </style>

    <!-- ========================================================== -->
    <!-- BARRAS SUPERIORES (TOOLBARS)                               -->
    <!-- ========================================================== -->
    <style name="RadarStock_Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/primary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">#CCFFFFFF</item>
        <item name="navigationIconTint">@color/white</item>
        <item name="titleTextAppearance">@style/RadarStock_TextAppearance_Toolbar_Title</item>
    </style>

    <style name="RadarStock_TextAppearance_Toolbar_Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_title_toolbar</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

</resources>
