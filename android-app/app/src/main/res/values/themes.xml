<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema Base de la Aplicación: Modo Claro Forzado -->
    <style name="Base.Theme.RadarStock" parent="Theme.Material3.Light.NoActionBar">
        <!-- Colores Principales del Tema -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_action</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Fondo y Superficies -->
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Barra de Estado (Azul Marino con Iconos Claros) -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Deshabilitar Forzado Automático de Modo Oscuro -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Estilos de Componentes Globales -->
        <item name="chipStyle">@style/RadarStock_Chip</item>
    </style>

    <style name="Theme.RadarStock" parent="Base.Theme.RadarStock" />
</resources>
