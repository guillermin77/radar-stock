<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso obligatorio para llamadas a la API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".RadarStockApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RadarStock"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Pantalla de Inicio: LoginActivity (dirige al menú si ya hay sesión) -->
        <activity
            android:name=".views.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Menú Principal -->
        <activity
            android:name=".views.MenuActivity"
            android:exported="false" />

        <!-- Registro de Ventas Rápidas -->
        <activity
            android:name=".views.VentaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Resumen de Ventas (Solo Administrador) -->
        <activity
            android:name=".views.ResumenActivity"
            android:exported="false" />

        <!-- Inventario de Productos -->
        <activity
            android:name=".views.ProductosActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Detalle de Producto -->
        <activity
            android:name=".views.DetalleProductoActivity"
            android:exported="false" />

        <!-- Formulario de Producto (Crear y Editar) -->
        <activity
            android:name=".views.ProductoFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Crear Producto (Placeholder «Próximamente») -->
        <activity
            android:name=".views.CrearProductoActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />
    </application>

</manifest>
